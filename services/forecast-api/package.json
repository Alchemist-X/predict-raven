  },
  "dependencies": {
    "@autopoly/forecast-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
